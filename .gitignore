# ============================================================
# DADOS
# ============================================================

# Arquivos de dados ficam apenas na maquina local.
# O codigo do projeto permite reconstruir as camadas.
dados/bronze/**
dados/prata/**
dados/ouro/**

# Mantem os diretorios acessiveis ao Git para que as excecoes
# abaixo possam ser versionadas.
!dados/bronze/**/
!dados/prata/**/
!dados/ouro/**/

# Mantem as pastas da arquitetura visiveis mesmo quando vazias.
!dados/**/.gitkeep

# Proveniencia e registro historico devem ser versionados.
# Aula 3: scripts, proveniencia e README sobem para o repositorio.
# Aula 5: a proveniencia da Prata e historica e nao e reconstruida
# de forma identica ao executar novamente a transformacao.
!dados/bronze/**/proveniencia.jsonl
!dados/prata/proveniencia.jsonl


# ============================================================
# RELATORIOS DE EXPLORACAO
# ============================================================

# Os relatorios de profiling sao gerados novamente a partir
# da Bronze e do codigo. Os achados relevantes ficam no README.
relatorios/


# ============================================================
# PYTHON
# ============================================================

__pycache__/
*.pyc


# ============================================================
# AMBIENTE VIRTUAL
# ============================================================

.venv/
venv/


# ============================================================
# EDITORES / IDEs
# ============================================================

.vscode/
.idea/


# ============================================================
# CREDENCIAIS E CONFIGURACOES LOCAIS
# ============================================================

.env